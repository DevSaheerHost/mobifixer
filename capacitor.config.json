{
  "appId": "com.mobifixer.app",
  "appName": "Mobifixer",
  "webDir": "www",
  "android": {
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": false,
      "resetWhenUpdate": true,
      "appReadyTimeout": 10000
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_notify",
      "iconColor": "#0ba2ff"
    }
  }
}
