<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Everything a notification needs - POST_NOTIFICATIONS, WAKE_LOCK and
        RECEIVE_BOOT_COMPLETED so reminders survive a restart - is declared by
        @capacitor/local-notifications and merged in at build time. They are
        not repeated here; duplicating them would mean two places to keep right.

        Deliberately NOT declared: USE_EXACT_ALARM. It is granted without
        asking, but Google Play only allows it for alarm and calendar apps, so
        a build carrying it would be rejected.

        And SCHEDULE_EXACT_ALARM is removed below, rather than merely left
        ungranted. The plugin declares it and defaults every notification to
        isExactNotification:true, which makes schedule() push Android's
        "Alarms & reminders" settings screen in front of the shop before it
        will schedule anything - a second permission screen, for a repair log,
        on the way in. native.js passes isExactNotification:false instead, so
        nothing asks for an exact alarm and this permission is dead weight: a
        sensitive one that Play questions for an app that is not a clock.

        The reminder still wakes the phone out of Doze, via
        setAndAllowWhileIdle; it lands in a window around the time rather than
        on the minute, which is the right trade for "remind me about this
        phone". To go back to exact timing, drop the tools:node="remove" and
        the isExactNotification:false in native.js together - one without the
        other is the broken state.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
                     tools:node="remove" />

    <!--
        Lets the app hand a downloaded APK to Android's package installer, for
        the self-update in native.js. Android still shows its own confirmation
        and will send the user to a settings screen first if they have not
        allowed this app to install packages - nothing installs quietly.

        This is for the APK shops download directly. Google Play forbids an app
        updating itself, so a Play build drops this line and sets SELF_INSTALL
        to false in native.js; the over-the-air web updates keep working either
        way, because they replace HTML and JavaScript rather than the app.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
